<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:StationeersModCreator.Desktop.ViewModels" x:Class="StationeersModCreator.Desktop.Views.NativeStudioView">
 <Border Background="#0B1420" Padding="24,22">
  <Grid RowDefinitions="Auto,Auto,*">
   <StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="WORLD / LOADOUT / CONTENT STUDIO"/><TextBlock Classes="heading" Text="Build a different beginning."/><TextBlock Classes="muted" Text="Create mod-owned definitions or replace only the exact setting you choose."/></StackPanel>
   <StackPanel Grid.Row="1" Spacing="12" Margin="0,18,0,18">
    <WrapPanel><Button Content="Worlds" Command="{Binding WorldsCommand}" Margin="0,0,8,8"/><Button Content="Starting conditions" Command="{Binding StartsCommand}" Margin="0,0,8,8"/><Button Content="Player equipment" Command="{Binding LoadoutsCommand}" Margin="0,0,8,8"/><Button Content="Respawn" Command="{Binding RespawnCommand}" Margin="0,0,8,8"/><Button Content="Landers &amp; cargo" Command="{Binding LandersCommand}" Margin="0,0,8,8"/><Button Content="Difficulty" Command="{Binding DifficultyCommand}" Margin="0,0,8,8"/></WrapPanel>
    <Grid ColumnDefinitions="230,*,Auto"><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch"/><TextBox Grid.Column="1" Margin="12,0" Watermark="Search definition IDs…" Text="{Binding Search}"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button Content="←" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding CountLabel}" Classes="muted" VerticalAlignment="Center"/><Button Content="→" Command="{Binding NextCommand}"/></StackPanel></Grid>
   </StackPanel>
   <Grid Grid.Row="2" ColumnDefinitions="*,570">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0"><ItemsControl ItemsSource="{Binding Definitions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:NativeDefinitionCardViewModel"><Button Classes="card" Command="{Binding SelectCommand}" Width="180" Height="194" Margin="0,0,12,12"><StackPanel Margin="13,10" Spacing="9"><TextBlock Text="{Binding Category}" Classes="eyebrow" FontSize="8"/><Image Source="{Binding Image}" Height="82"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" MaxHeight="36"/><TextBlock Text="{Binding State}" Classes="mono" FontSize="8"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Border Grid.Column="1" Classes="panel" Padding="18" DataContext="{Binding Editor}">
     <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="10"><TextBlock Classes="eyebrow" Text="DEFINITION INSPECTOR"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap"/><TextBlock Text="{Binding Policy}" Classes="muted" TextWrapping="Wrap" FontSize="11"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ExportId}" IsEnabled="{Binding CanEdit}" Watermark="Exact export ID"/><Button Grid.Column="1" Content="Clone locally" Command="{Binding CloneCommand}" IsEnabled="{Binding CanEdit}" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding Breadcrumb}" Classes="mono" TextWrapping="Wrap"/><WrapPanel><Button Classes="small" Content="Root" Command="{Binding RootCommand}" Margin="0,0,7,7"/><Button Classes="small" Content="Parent" Command="{Binding ParentCommand}" Margin="0,0,7,7"/><Button Classes="small" Content="Follow reference →" Command="{Binding FollowReferenceCommand}" Margin="0,0,7,7"/><Button Classes="small" Content="Fork reference for this profile" Command="{Binding ForkReferenceCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,7,7"/></WrapPanel></StackPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,12"><StackPanel Spacing="15">
       <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:NativeFieldEditorViewModel"><Grid ColumnDefinitions="*,200" Margin="0,0,0,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Original,StringFormat='Source: {0}'}" Classes="muted" TextWrapping="Wrap" FontSize="10"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Value}" Classes.changed="{Binding IsChanged}" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Classes="eyebrow" Text="CONTENTS / CONDITIONS / REFERENCES"/>
       <ItemsControl ItemsSource="{Binding Nodes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:XmlNodeCardViewModel"><Button Classes="card" Command="{Binding OpenCommand}" Width="245" MinHeight="85" Margin="0,0,8,8"><Grid ColumnDefinitions="54,*" Margin="10"><Image Source="{Binding Image}" Width="46" Height="46"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Tag}" Classes="eyebrow" FontSize="8"/><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="Add an optional scalar setting" IsEnabled="{Binding CanEdit}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding ScalarProperties}" SelectedItem="{Binding PropertyName}" HorizontalAlignment="Stretch"/><TextBox Watermark="Explicit value" Text="{Binding PropertyValue}"/><Button Content="Add setting" Command="{Binding AddPropertyCommand}"/></StackPanel></Expander>
       <Expander Header="Add cargo item" IsEnabled="{Binding CanEdit}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding ItemIds}" SelectedItem="{Binding ItemId}" HorizontalAlignment="Stretch"/><Grid ColumnDefinitions="*,Auto"><TextBox Watermark="Quantity" Text="{Binding Quantity}"/><Button Grid.Column="1" Content="Add separate stack" Command="{Binding AddItemCommand}" Margin="10,0,0,0"/></Grid><TextBlock Text="Open a spawn package, item or container before adding cargo." Classes="muted" TextWrapping="Wrap"/></StackPanel></Expander>
       <Expander Header="Add event / spawn reference" IsEnabled="{Binding CanEdit}"><StackPanel Spacing="9"><TextBox Watermark="Source or staged spawn ID" Text="{Binding ReferenceId}"/><ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding Event}" HorizontalAlignment="Stretch"/><Button Content="Add reference" Command="{Binding AddReferenceCommand}"/><TextBlock Text="Start-condition references receive the selected event. Nested spawn references retain their own context." Classes="muted" TextWrapping="Wrap"/></StackPanel></Expander>
       <Expander Header="Assign starting condition to a world" IsEnabled="{Binding CanEdit}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding WorldIds}" SelectedItem="{Binding WorldId}" HorizontalAlignment="Stretch"/><Button Content="Set exact world injection" Command="{Binding AssignWorldCommand}"/><TextBlock Text="Replaces this profile's injection selection; no world file is copied." Classes="muted" TextWrapping="Wrap"/></StackPanel></Expander>
       <WrapPanel IsEnabled="{Binding CanEdit}"><Button Classes="small" Content="Duplicate this node" Command="{Binding DuplicateNodeCommand}" Margin="0,0,8,0"/><Button Classes="small" Content="Remove this node" Command="{Binding RemoveNodeCommand}"/></WrapPanel>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Spacing="10"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><Grid ColumnDefinitions="*,Auto"><Button Classes="primary" x:Name="NativeStageButton" Content="STAGE DEFINITION" Command="{Binding StageCommand}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><Button Grid.Column="1" Content="Restore" Command="{Binding RestoreCommand}" Margin="10,0,0,0"/></Grid></StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</UserControl>
