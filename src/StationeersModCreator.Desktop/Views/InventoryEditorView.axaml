<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:StationeersModCreator.Desktop.ViewModels" x:Class="StationeersModCreator.Desktop.Views.InventoryEditorView">
<Border Background="#0B1420" Padding="24,22"><Grid RowDefinitions="Auto,Auto,*">
<StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="START / RESPAWN / NESTED INVENTORY"/><TextBlock Classes="heading" Text="{Binding SetupTitle}"/><TextBlock Classes="muted" Text="{Binding SetupDescription}"/></StackPanel>
<Grid Grid.Row="1" ColumnDefinitions="*,150,150,Auto" Margin="0,20,0,18"><ComboBox ItemsSource="{Binding Starts}" SelectedItem="{Binding StartId}" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="1" ItemsSource="{Binding Species}" SelectedItem="{Binding SpeciesName}" Margin="10,0,0,0" HorizontalAlignment="Stretch"/><ComboBox Grid.Column="2" ItemsSource="{Binding Difficulties}" SelectedItem="{Binding Difficulty}" Margin="10,0,0,0" HorizontalAlignment="Stretch"/><Button Grid.Column="3" Content="Load inventory" Command="{Binding LoadCommand}" Margin="10,0,0,0"/></Grid>
<Grid Grid.Row="2" ColumnDefinitions="*,430">
<Border Classes="panel" Padding="18" Margin="0,0,18,0"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Breadcrumb}" Classes="eyebrow" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="muted"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,15,0,18"><Button Content="Character" Command="{Binding RootCommand}"/><Button Content="Parent container" Command="{Binding ParentCommand}"/><TextBlock Text="Click a slot → inspect → open contents" Classes="muted" VerticalAlignment="Center"/></StackPanel><ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14"><ItemsControl ItemsSource="{Binding Slots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:InventorySlotCardViewModel"><Button Classes="card" Command="{Binding SelectCommand}" Width="190" Height="188" Margin="0,0,12,12"><StackPanel Margin="12" Spacing="8"><TextBlock Text="{Binding Label}" Classes="eyebrow" FontSize="9"/><Image Source="{Binding Image}" Height="76"/><TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" MaxHeight="38"/><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Slot classes and capacities come from the actual prefab. Organ slots are species-managed. This preview does not simulate survival." Classes="muted" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FFB35D" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid></Border>
<Border Grid.Column="1" Classes="panel" Padding="18"><Grid RowDefinitions="Auto,*,Auto"><StackPanel Spacing="9"><TextBlock Classes="eyebrow" Text="SLOT INSPECTOR"/><TextBlock Text="{Binding SelectedName}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedSlot}" Classes="muted"/><Button Content="Open item contents →" Command="{Binding OpenContentsCommand}" IsEnabled="{Binding CanOpen}"/></StackPanel><ScrollViewer Grid.Row="1" Margin="0,14"><StackPanel Spacing="14"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:NativeFieldEditorViewModel"><StackPanel Spacing="5" Margin="0,0,0,10"><TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/><TextBox Text="{Binding Value}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Expander Header="Add to this empty slot" IsEnabled="{Binding CanEditSlot}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding ItemIds}" SelectedItem="{Binding ItemId}" HorizontalAlignment="Stretch"/><TextBox Text="{Binding Quantity}" Watermark="Quantity"/><Button Content="Add compatible item" Command="{Binding AddCommand}" x:Name="InventoryAddButton"/></StackPanel></Expander>
<Expander Header="Quantity / battery charge" IsEnabled="{Binding HasItem}"><StackPanel Spacing="9"><TextBox Text="{Binding Quantity}" Watermark="Quantity"/><Button Content="Apply quantity" Command="{Binding ApplyQuantityCommand}"/><ComboBox ItemsSource="{Binding ChargeStates}" SelectedItem="{Binding Charge}" HorizontalAlignment="Stretch"/><Button Content="Apply battery charge" Command="{Binding ApplyChargeCommand}"/></StackPanel></Expander>
<Expander Header="Add gas entry" IsEnabled="{Binding HasItem}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding GasTypes}" SelectedItem="{Binding GasType}" HorizontalAlignment="Stretch"/><TextBox Text="{Binding GasMoles}" Watermark="Moles"/><TextBox Text="{Binding GasCelsius}" Watermark="Celsius"/><Button Content="Add separate gas entry" Command="{Binding AddGasCommand}"/></StackPanel></Expander>
<Expander Header="Move into another container" IsEnabled="{Binding HasItem}"><StackPanel Spacing="9"><ComboBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Destination}" HorizontalAlignment="Stretch"/><Button Content="Move to empty compatible slot" Command="{Binding MoveCommand}"/></StackPanel></Expander><Button Content="Remove item and contents" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasItem}"/>
</StackPanel></ScrollViewer><StackPanel Grid.Row="2" Spacing="10"><TextBlock Text="New mod-owned start ID" Classes="eyebrow" FontSize="9"/><TextBox Text="{Binding ExportStartId}"/><TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" MaxHeight="90"/><Grid ColumnDefinitions="*,90"><Button MinWidth="0" Padding="10" FontSize="12" Content="STAGE KIT" Command="{Binding StageCommand}" Classes="primary" x:Name="InventoryStageButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><Button Grid.Column="1" Width="82" Padding="8,10" Content="Restore" Command="{Binding RestoreCommand}" Margin="8,0,0,0"/></Grid></StackPanel></Grid></Border>
</Grid></Grid></Border></UserControl>
