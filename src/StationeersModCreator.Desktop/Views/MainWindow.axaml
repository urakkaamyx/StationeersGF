<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:StationeersModCreator.Desktop.ViewModels" xmlns:views="using:StationeersModCreator.Desktop.Views" x:Class="StationeersModCreator.Desktop.Views.MainWindow" x:Name="Root" Title="Stationeers • Orbital Forge" Width="1600" Height="1020" MinWidth="1240" MinHeight="820" FontSize="{Binding FontSize}">
 <Window.KeyBindings><KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/><KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/><KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}"/><KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/></Window.KeyBindings>
 <Grid RowDefinitions="82,*,38">
  <Border Grid.Row="0" Background="#101B27" BorderBrush="#2B3A4C" BorderThickness="0,0,0,1" Padding="26,15">
   <Grid ColumnDefinitions="232,*,Auto">
    <StackPanel><TextBlock Classes="eyebrow" Text="STATIONEERS / MOD CREATOR"/><TextBlock Text="ORBITAL FORGE" FontSize="23" FontWeight="Bold" LetterSpacing="1.4" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0"><TextBlock Text="BUILD BEYOND THE BLUEPRINT" FontSize="10" LetterSpacing="2.8" Foreground="#7F96AD"/><TextBlock Text="{Binding ModName}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Button Content="Open project" Command="{Binding OpenCommand}"/><Button Content="Undo" Command="{Binding UndoCommand}"/><Button Content="Redo" Command="{Binding RedoCommand}"/><Button x:Name="SaveProjectButton" Content="Save project" Command="{Binding SaveCommand}"/><Button x:Name="ExportModButton" Classes="primary" Content="EXPORT MOD  ↗" Command="{Binding ExportCommand}" Padding="22,12"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="232,*,350">
   <Border Background="#0F1925" BorderBrush="#263649" BorderThickness="0,0,1,0" Padding="17,25">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
     <StackPanel><TextBlock Classes="eyebrow" Text="YOUR WORKBENCH" Margin="15,0,0,16"/><Button Classes="nav" Classes.active="{Binding IsSetup}" Content="Mod setup" Command="{Binding SetupCommand}"/><Button Classes="nav" Classes.active="{Binding IsNativeStudio}" Content="World setup" Command="{Binding WorldSetupCommand}"/><Button Classes="nav" Classes.active="{Binding IsStarting}" Content="Starting setup" Command="{Binding InventoryCommand}"/><Button Classes="nav" Classes.active="{Binding IsRespawn}" Content="Respawn setup" Command="{Binding RespawnSetupCommand}"/><Button Classes="nav" Classes.active="{Binding IsRecipes}" Content="Recipes by machine" Command="{Binding RecipesCommand}"/><Button Classes="nav" Classes.active="{Binding IsAttributes}" Content="Prefab attributes" Command="{Binding AttributesCommand}"/><Button Classes="nav" Classes.active="{Binding IsArtwork}" Content="Asset library" Command="{Binding ArtworkCommand}"/><Button Classes="nav" Classes.active="{Binding IsWorkspace}" Content="Mod workspace" Command="{Binding WorkspaceCommand}"/></StackPanel>
     <Border Grid.Row="1" Height="1" Background="#263649" Margin="14,26"/>
     <StackPanel Grid.Row="2" Margin="15,0"><TextBlock Classes="eyebrow" Text="SOURCE PROFILE" Foreground="#8D9DAE"/><TextBlock Text="Stationeers" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock Text="{Binding CatalogLabel}" Classes="muted" TextWrapping="Wrap"/><Border Background="#17332E" BorderBrush="#2C564B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,15,0,0" HorizontalAlignment="Left"><TextBlock Text="●  OFFLINE DATA READY" FontSize="9" FontWeight="SemiBold" LetterSpacing="1" Foreground="#8BE2B5"/></Border></StackPanel>
     <StackPanel Grid.Row="4" Spacing="12"><Border Classes="panel" Padding="16"><StackPanel Spacing="7"><TextBlock Classes="eyebrow" Text="MOD PAYLOAD"/><TextBlock Text="{Binding DraftLabel}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SaveState}" Classes="mono"/></StackPanel></Border><Button Classes="nav" Content="⚙   Appearance" Command="{Binding SettingsCommand}"/><Button Classes="small" Content="+  New mod project" Command="{Binding NewProjectCommand}"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="26,23,24,18" RowDefinitions="76,*">
    <StackPanel Spacing="8"><TextBlock Classes="eyebrow" Text="CREATE / CUSTOMIZE / EXPORT"/><TextBlock Classes="heading" Text="{Binding PageTitle}"/><TextBlock Classes="muted" Text="{Binding PageDescription}"/></StackPanel>
    <Grid Grid.Row="1" IsVisible="{Binding IsRecipes}" RowDefinitions="171,Auto,*">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,13,0,12">
      <ItemsControl ItemsSource="{Binding Machines}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MachineCardViewModel">
       <Button Classes="card" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Width="165" Height="139"><Grid RowDefinitions="*,Auto" Margin="13,8"><Grid><TextBlock Text="{Binding Category}" FontSize="8" LetterSpacing="1.2" Foreground="#849AAC" VerticalAlignment="Top"/><Image Source="{Binding Image}" Width="77" Height="77" VerticalAlignment="Bottom"/></Grid><StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Grid></Button>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
     <Grid Grid.Row="1" ColumnDefinitions="*,230" Margin="0,0,0,15"><StackPanel Spacing="5"><TextBlock Text="{Binding MachineName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultLabel}" Classes="muted"/></StackPanel><TextBox x:Name="RecipeSearch" Grid.Column="1" Watermark="Search items or prefab names…" Text="{Binding Search}" VerticalAlignment="Center"/></Grid>
     <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Recipes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipeCardViewModel">
      <Button Classes="card" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Width="{Binding $parent[Window].DataContext.CardWidth}" Height="211" Margin="0,0,12,12"><Grid RowDefinitions="110,*,Auto" Margin="14,11"><Grid><Border Background="#102B35" CornerRadius="45" Width="88" Height="88" Opacity="0.5"/><Image Source="{Binding Image}" Width="99" Height="99"/></Grid><StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MaterialLabel}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProcessLabel}" Classes="mono" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding StateLabel}" FontSize="8" LetterSpacing="1.2" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/></Grid></Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsAttributes}" RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
     <TextBox Text="{Binding Search}" Watermark="Find an item, structure, or prefab…" Margin="0,0,0,18"/>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Prefabs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PrefabCardViewModel"><Button Classes="card" Command="{Binding SelectCommand}" Width="{Binding $parent[Window].DataContext.CardWidth}" Height="178" Margin="0,0,12,12"><StackPanel Margin="14,10" Spacing="9"><Image Source="{Binding Image}" Width="92" Height="92"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Classes="small" Content="← Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageLabel}" Classes="mono" VerticalAlignment="Center"/><Button Classes="small" Content="Next →" Command="{Binding NextPageCommand}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsArtwork}" RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
     <TextBox Text="{Binding Search}" Watermark="Search the extracted game artwork…" Margin="0,0,0,18"/>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Artwork}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ArtworkCardViewModel"><Button Classes="card" Command="{Binding SelectCommand}" Width="{Binding $parent[Window].DataContext.CardWidth}" Height="172" Margin="0,0,12,12"><StackPanel Margin="14,9" Spacing="9"><Image Source="{Binding Image}" Width="105" Height="105"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="11"/><TextBlock Text="USE AS MOD PREVIEW ↗" FontSize="8" LetterSpacing="1" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0"><Button Classes="small" Content="← Previous" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageLabel}" Classes="mono" VerticalAlignment="Center"/><Button Classes="small" Content="Next →" Command="{Binding NextPageCommand}"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsWorkspace}" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0"><StackPanel Spacing="18">
     <Border Classes="panel"><StackPanel Spacing="16"><TextBlock Classes="eyebrow" Text="MOD IDENTITY"/><TextBox Text="{Binding ModName}" Watermark="Mod name"/><Grid ColumnDefinitions="*,140"><TextBox Text="{Binding Author}" Watermark="Author" Margin="0,0,12,0"/><TextBox Grid.Column="1" Text="{Binding Version}" Watermark="Version"/></Grid><TextBox Text="{Binding Description}" Watermark="What does your mod change?" AcceptsReturn="True" TextWrapping="Wrap" Height="88"/></StackPanel></Border>
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding DraftLabel}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="primary" Content="EXPORT NATIVE MOD ↗" Command="{Binding ExportCommand}"/></Grid>
     <TextBlock Classes="muted" Text="Only staged overrides are exported. Choose the mod's load order in Stationeers and verify its active values." TextWrapping="Wrap"/>
     <Expander Header="Exact mod export plan" IsExpanded="True"><StackPanel Spacing="10"><TextBlock Text="Game files are never modified. Complete records are emitted only where the native loader requires exact-definition replacement. No whole source files, source catalogs or editable project copies are bundled." Classes="muted" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding ExportPlan}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="panel" Margin="0,0,0,8"><StackPanel Spacing="6"><TextBlock Text="{Binding Identity}" FontWeight="SemiBold"/><TextBlock Text="{Binding Operation}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander><ItemsControl ItemsSource="{Binding Changes}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DraftChangeViewModel"><Border Classes="panel" Margin="0,0,0,10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Subtitle}" Classes="mono"/><TextBlock Text="{Binding Changes}" Foreground="#E4B66C" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="small" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Top"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Column="2" Background="#111D2A" BorderBrush="#2A3A4D" BorderThickness="1,0,0,0" Padding="24,25">
    <Grid>
    <Grid IsVisible="{Binding IsRecipes}" RowDefinitions="Auto,*,Auto">
     <StackPanel><TextBlock Classes="eyebrow" Text="RECIPE INSPECTOR"/><Image Source="{Binding SelectedRecipe.Image}" Height="143" Margin="0,16,0,4"/><TextBlock Text="{Binding SelectedRecipe.Name}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedRecipe.Prefab}" Classes="mono" TextWrapping="Wrap" Margin="0,7,0,16"/><Border Height="1" Background="#2B3D50"/><TextBlock Text="SOURCE → YOUR OVERRIDE" Classes="eyebrow" FontSize="9" Foreground="#C7A16B" Margin="0,19,0,13"/></StackPanel>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="15"><ItemsControl ItemsSource="{Binding SelectedRecipe.Fields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FieldEditorViewModel"><Grid ColumnDefinitions="*,110" Margin="0,0,0,14"><StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Classes="mono" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Original,StringFormat='Source: {0}'}" Classes="muted" FontSize="10"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Value}" Classes.changed="{Binding IsChanged}" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="#172837" CornerRadius="7" Padding="13"><TextBlock Classes="muted" Text="Values retain the game's raw units. Nested furnace constraints are preserved in your exported recipe." FontSize="11" TextWrapping="Wrap"/></Border><Expander Header="Source &amp; provenance"><StackPanel Spacing="8"><TextBlock Text="{Binding SelectedRecipe.Definition.SourcePath}" Classes="mono" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedRecipe.Definition.SourceHash}" Classes="mono" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedRecipe.Definition.Section}" Classes="mono" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Spacing="10" Margin="0,18,0,0"><Button x:Name="StageRecipeButton" Classes="primary" Content="STAGE RECIPE OVERRIDE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding StageRecipeCommand}"/><Button Content="Restore source values" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ResetRecipeCommand}"/></StackPanel>
    </Grid>
    <Grid IsVisible="{Binding IsAttributes}" RowDefinitions="Auto,*,Auto"><StackPanel><TextBlock Classes="eyebrow" Text="PREFAB INSPECTOR"/><Image Source="{Binding SelectedPrefab.Image}" Height="134" Margin="0,14"/><TextBlock Text="{Binding SelectedPrefab.Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedPrefab.Definition.Name}" Classes="mono" TextWrapping="Wrap" Margin="0,8,0,20"/></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SelectedPrefab.Fields}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FieldEditorViewModel"><StackPanel Margin="0,0,0,16" Spacing="7"><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,130"><TextBlock Text="{Binding Original,StringFormat='Source: {0}'}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBox Grid.Column="1" Text="{Binding Value}" Classes.changed="{Binding IsChanged}"/></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0"><Button Classes="primary" Content="STAGE ATTRIBUTE OVERRIDE" Command="{Binding StageAttributesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/><Button Content="Restore source values" Command="{Binding ResetAttributesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/></StackPanel></Grid>
    <StackPanel IsVisible="{Binding IsArtwork}" Spacing="18"><TextBlock Classes="eyebrow" Text="MOD COVER ART"/><Image Source="{Binding PreviewImage}" Height="235"/><TextBlock Text="A recognizable signature." FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Choose a card in the library to set your mod's preview. The image is packaged with your exported mod." Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding PreviewName}" Classes="mono" TextWrapping="Wrap"/><Button Content="Review mod workspace →" Command="{Binding WorkspaceCommand}"/></StackPanel>
    <StackPanel IsVisible="{Binding IsWorkspace}" Spacing="18"><TextBlock Classes="eyebrow" Text="EXPORT PAYLOAD"/><Image Source="{Binding PreviewImage}" Height="205"/><TextBlock Text="{Binding ModName}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding DraftLabel}" Foreground="{DynamicResource AccentBrush}"/><Border Height="1" Background="#2B3D50"/><TextBlock Text="NATIVE STATIONEERS MOD" Classes="eyebrow" FontSize="9"/><TextBlock Text="Only staged definitions&#10;Explicit property overrides&#10;Selected preview artwork&#10;Mod metadata" Classes="muted" LineHeight="24"/><Button Content="Change preview artwork →" Command="{Binding ArtworkCommand}"/><Button Content="Save editable project" Command="{Binding SaveCommand}"/></StackPanel>
    </Grid>
   </Border>
   <views:SetupDashboardView Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding IsSetup}"/>
   <views:InventoryEditorView Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding #Root.DataContext.IsInventory}" DataContext="{Binding Inventory}"/>
   <views:NativeStudioView Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding #Root.DataContext.IsNativeStudio}" DataContext="{Binding NativeStudio}"/>
  </Grid>
  <Border Grid.Row="2" Background="#0D1824" BorderBrush="#293A4C" BorderThickness="0,1,0,0" Padding="24,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding SnapshotLabel}" Classes="mono" VerticalAlignment="Center" Margin="20,0,0,0"/></Grid></Border>
  <Border Grid.RowSpan="3" Background="#CC060D15" IsVisible="{Binding SettingsOpen}"><Border Classes="panel" Width="510" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32"><StackPanel Spacing="22"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Make it your station." FontSize="26" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="small" Content="✕" Command="{Binding CloseSettingsCommand}"/></Grid><TextBlock Classes="muted" Text="Your appearance settings are saved automatically."/><StackPanel Spacing="9"><TextBlock Classes="eyebrow" Text="ACCENT SIGNAL"/><ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Spacing="9"><TextBlock Classes="eyebrow" Text="TEXT SCALE"/><Slider Minimum="0.85" Maximum="1.3" Value="{Binding FontScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/></StackPanel><ToggleSwitch Content="Compact gallery cards" IsChecked="{Binding CompactCards}"/><ToggleSwitch Content="Higher text contrast" IsChecked="{Binding HighContrast}"/><Button Classes="primary" Content="BACK TO THE FORGE" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CloseSettingsCommand}"/></StackPanel></Border></Border>
 </Grid>
</Window>
