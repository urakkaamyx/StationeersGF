		<ItemReplacement Substitute="ItemMKIIArcWelder" Replaces="ItemWeldingTorch" />
		<ItemReplacement Substitute="ItemEmergencyAngleGrinder" Replaces="ItemAngleGrinder" />
		<ItemReplacement Substitute="ItemMKIIAngleGrinder" Replaces="ItemAngleGrinder" />
		<ItemReplacement Substitute="ItemEmergencyCrowbar" Replaces="ItemCrowbar" />
		<ItemReplacement Substitute="ItemMKIICrowbar" Replaces="ItemCrowbar" />
		<ItemReplacement Substitute="ItemEmergencyDrill" Replaces="ItemDrill" />
		<ItemReplacement Substitute="ItemMKIIDrill" Replaces="ItemDrill" />
		<ItemReplacement Substitute="ItemEmergencyScrewdriver" Replaces="ItemScrewdriver" />
		<ItemReplacement Substitute="ItemMKIIScrewdriver" Replaces="ItemScrewdriver" />
		<ItemReplacement Substitute="ItemEmergencyWireCutters" Replaces="ItemWireCutters" />
		<ItemReplacement Substitute="ItemMKIIWireCutters" Replaces="ItemWireCutters" />
		<ItemReplacement Substitute="ItemEmergencyWrench" Replaces="ItemWrench" />
		<ItemReplacement Substitute="ItemMKIIWrench" Replaces="ItemWrench" />
