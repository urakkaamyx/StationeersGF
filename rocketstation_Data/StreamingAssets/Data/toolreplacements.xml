<?xml version="1.0" encoding="utf-8"?>
<GameData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<!--
		Tool replacements: the Substitute tool is accepted anywhere the Replaces tool is required
		(construction, deconstruction, repair, upgrade). Same schema and rules as materialreplacements.xml.
	-->
